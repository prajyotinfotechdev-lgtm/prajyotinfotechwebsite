{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/retry-lead-notifications",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/diwali-offers-2026",
      "destination": "/free-business-tech-audit",
      "permanent": true
    },
    {
      "source": "/software-company-in-navi-mumbai",
      "destination": "/software-company-in-mumbai",
      "permanent": true
    },
    {
      "source": "/software-company-in-bangalore",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/software-company-in-delhi",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/software-company-in-hyderabad",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/software-company-in-usa",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/software-company-in-uk",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/software-company-in-uae",
      "destination": "/services",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|assets|images|icons|videos|og|audio|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
